# ── Moonrelay ──────────────────────────────────────────────────────────
# Force Unix line endings for tooling so dpkg-deb/rpmbuild/MakeAppx
# steps see LF inside shell scripts, then default to LF elsewhere
# (Markdown/YAML) but native for Windows runner binaries.
*             text=auto eol=lf

# Shell, sed, perl, and packaging specs MUST be LF.
*.sh          text eol=lf
linux/packaging/* text eol=lf
*.spec        text eol=lf
tools/*       text eol=lf

# Windows native files
*.rc          text eol=crlf
*.manifest    text eol=crlf
*.sln         text eol=crlf

# Generated localization (regenerated by gen-l10n)
lib/src/localization/**  linguist-generated
pubspec.lock             linguist-generated
